  "tokenColors": [
    {
      "name": "Body text",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#C2C2CB"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#666671",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "support.variable",
        "meta.definition.variable.name",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#C2C2CB"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#84848F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Members and properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "entity.name.variable.field",
        "variable.object.property"
      ],
      "settings": {
        "foreground": "#8A79C8"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.brace",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#84848F"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "foreground": "#D0568E"
      }
    },
    {
      "name": "Language variables (this, self, super)",
      "scope": [
        "variable.language",
        "variable.language.this",
        "keyword.other.this"
      ],
      "settings": {
        "foreground": "#D0568E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Imports, modifiers, macros",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.at-rule",
        "support.function.macro",
        "entity.name.function.macro"
      ],
      "settings": {
        "foreground": "#AC6DBC"
      }
    },
    {
      "name": "Decorators and attributes",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "meta.attribute",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#AC6DBC"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#EF7F3C"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant",
        "constant.language.boolean",
        "constant.language.null",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#EF7F3C"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string",
        "string.template",
        "string.unquoted"
      ],
      "settings": {
        "foreground": "#74AAA6"
      }
    },
    {
      "name": "String interpolation punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#D0568E"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "string.regexp punctuation.definition.string",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#F2CE6E"
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape",
        "constant.character",
        "string.regexp constant.character.escape"
      ],
      "settings": {
        "foreground": "#E2564F"
      }
    },
    {
